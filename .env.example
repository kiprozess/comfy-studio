# Create a key at https://platform.comfy.org/ and copy this file to .env.local.
# Server only. Never prefix this key with NEXT_PUBLIC_.
COMFY_API_KEY=

# Upscaler: unset uses the Ultimate Image Upscaler through Comfy Router (pay per run).
# Set to "seedvr2" to run our own SeedVR2 workflow on Comfy Cloud; that needs a paid Comfy Cloud plan.
# COMFY_UPSCALER=seedvr2

# Required for production; optional for local development.
# Persistent, absolute directory outside public/ for shared submission counters.
# All replicas must share this directory. No password or login is required.
# APP_RATE_LIMIT_DIR=/var/lib/comfy-studio/limits
# Shared limits across try-on, flatlay, pose and upscale (positive integers).
# APP_REQUESTS_PER_MINUTE=6
# APP_REQUESTS_PER_DAY=50

# Public origin for a custom domain / reverse proxy (scheme + host + optional port).
# Railway's generated domain is detected automatically from RAILWAY_PUBLIC_DOMAIN.
# APP_ORIGIN=https://your-app.example.com
